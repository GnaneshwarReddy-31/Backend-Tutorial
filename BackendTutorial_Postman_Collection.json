{
  "info": {
    "name": "Backend Tutorial API",
    "_postman_id": "backend-tutorial-v1",
    "description": "Testing collection for Backend Tutorial assignment (port 8000)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"gnaneshwar\",\n  \"email\": \"gnaneshwar@example.com\",\n  \"password\": \"pass123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/v1/users/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "v1", "users", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"gnaneshwar\",\n  \"password\": \"pass123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/v1/users/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "v1", "users", "login"]
            }
          }
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8000/api/v1/users",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "v1", "users"]
            }
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create Post",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My first post\",\n  \"content\": \"Learning Node.js and Express is fun\",\n  \"author\": \"PASTE_USER_ID_HERE\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/v1/posts",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "v1", "posts"]
            }
          }
        },
        {
          "name": "Get All Posts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8000/api/v1/posts",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "v1", "posts"]
            }
          }
        },
        {
          "name": "Get Post by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8000/api/v1/posts/:id",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "v1", "posts", ":id"],
              "variable": [{ "key": "id", "value": "PASTE_POST_ID_HERE" }]
            }
          }
        },
        {
          "name": "Update Post",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated title\",\n  \"content\": \"Updated content here\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/v1/posts/:id",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "v1", "posts", ":id"],
              "variable": [{ "key": "id", "value": "PASTE_POST_ID_HERE" }]
            }
          }
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "http://localhost:8000/api/v1/posts/:id",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "v1", "posts", ":id"],
              "variable": [{ "key": "id", "value": "PASTE_POST_ID_HERE" }]
            }
          }
        }
      ]
    }
  ]
